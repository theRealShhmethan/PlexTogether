# Copy to .env.local and adjust. Never commit .env.local.
# None of these are secrets today; Plex tokens are obtained at runtime and kept in server memory only.

# Public origin of this app. Must exactly match the URL you open in the browser
# (used for the Plex sign-in return URL and same-origin checks).
APP_URL=http://localhost:3000

# Name shown in plex.tv > Account > Authorized Devices.
PLEX_PRODUCT_NAME=PlexTogether

# Plex sign-in method: "legacy" (default) or "jwt".
# JWT is Plex's recommended method, but Plex Media Server currently rejects JWT
# tokens (401), so a JWT sign-in can't reach any server. See docs/ARCHITECTURE.md.
PLEX_AUTH_MODE=legacy
